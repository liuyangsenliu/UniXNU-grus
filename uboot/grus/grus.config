# grus deltas on top of qcom_defconfig + qcom-phone.config.
# Applied as a kconfig fragment: make qcom_defconfig qcom-phone.config grus.config
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/xiaomi/grus/grus.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BCB=y
CONFIG_SYS_CBSIZE=1024
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y
# Framebuffer console on the ABL splash buffer (DTS chosen/framebuffer@9c000000).
# Without this, stdout-path="framebuffer" points at nothing, stdio never
# initialises, and main_loop freezes before bootcmd runs.
CONFIG_VIDEO=y
CONFIG_DM_VIDEO=y
CONFIG_VIDEO_SIMPLE=y
# VIDEO_COPY keeps a shadow buffer and only blits it out on video_sync(), which
# runs from the cyclic framework inside main_loop. If main_loop stalls before
# that, the panel keeps showing the ABL splash and nothing is ever visible.
# Draw straight into the display buffer instead.
# CONFIG_VIDEO_COPY is not set
CONFIG_CONSOLE_NORMAL=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
