# grus deltas on top of qcom_defconfig + qcom-phone.config.
# Applied as a kconfig fragment: make qcom_defconfig qcom-phone.config grus.config
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/xiaomi/grus/grus.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BCB=y
CONFIG_SYS_CBSIZE=1024
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y
# NOTE (v16): VIDEO reverted. With VIDEO_SIMPLE enabled, dm_autoprobe gained a
# new device to probe (the simple-framebuffer), and boots started freezing
# nondeterministically inside the DM scan/probe initcall (binary readout=11)
# while other boots of the same image passed all 47 initcalls. Revert to the
# v10 configuration that is known to complete board_init_r; the framebuffer
# bands remain the debug channel. Re-add video only after the DM probe race
# is understood.
# CONFIG_VIDEO is not set (explicitly dropped, see note above)
# main_loop() calls process_button_cmds() before bootcmd. grus buttons live on
# the PMIC (SPMI), which is not up in this U-Boot port, so probing them stalls
# the boot before bootcmd ever runs. Keep every button/keyboard path off.
# NOTE: merge_config.sh drops "# CONFIG_X is not set" comment lines, so these
# must be written as explicit =n assignments.
CONFIG_BUTTON=n
CONFIG_BUTTON_CMD=n
CONFIG_BUTTON_GPIO=n
CONFIG_BUTTON_QCOM_PMIC=n
CONFIG_BUTTON_KEYBOARD=n
CONFIG_BUTTON_REMAP_PHONE_KEYS=n

# v31: do NOT take the control device tree from the prior-stage bootloader
# (Qualcomm ABL). With CONFIG_OF_BOARD=y, gd->fdt_blob points at the STOCK
# grus tree that ABL passes in, so dm_scan_fdt() binds hundreds of nodes
# (PMIC, charger, display, ...) and one of those binds never returns --
# measured: bind counter frozen at 143. The image instead ships the curated
# sdm710-xiaomi-grus.dtb (ufshc@1d84000 + qmp-ufs-phy + gcc-sdm670 + tlmm),
# which matches the drivers this U-Boot actually has. With OF_BOARD off and
# OF_SEPARATE on, that appended DTB is used.
CONFIG_OF_BOARD=n
