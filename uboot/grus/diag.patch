+/* DIAG: proof-of-life paint into the continuous-splash framebuffer (grus) */
+static void diag_band(int y0, int y1, unsigned int color)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x9c000000;
+	int x, y;
+
+	for (y = y0; y < y1; y++)
+		for (x = 0; x < 270; x++)
+			fb[y * 1080 + x] = color;
+}
+
+/* DIAG: one white 70x70 block per *started* board_init_r initcall.
+ * 10 blocks per row starting at y=600; the block count identifies which
+ * initcall hung (block N means initcall N was entered and never returned).
+ */
+static int diag_ic_n;
+
+void diag_initcall_tick(void)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x9c000000;
+	int n = diag_ic_n++;
+	int x0, y0, x, y;
+
+	if (n < 0 || n >= 65)
+		return;
+	x0 = 10 + (n % 10) * 100;
+	y0 = 600 + (n / 10) * 100;
+	for (y = y0; y < y0 + 70; y++)
+		for (x = x0; x < x0 + 70; x++)
+			fb[y * 1080 + x] = 0xffffffff;
+}
+
+void diag_initcall_reset(void)
+{
+	diag_ic_n = 0;
+}
+
 void board_init_r(gd_t *new_gd, ulong dest_addr)
 {
+	/* DIAG: board_init_r reached */
+	diag_band(300, 450, 0xffffff00);
+	diag_initcall_reset();
+
 	/*
