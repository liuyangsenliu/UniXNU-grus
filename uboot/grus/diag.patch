+}
+
+static void diag_band_full(int y0, int y1, unsigned int color)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x9c000000;
+	int x, y;
+
+	for (y = y0; y < y1; y++)
+		for (x = 0; x < 1080; x++)
+			fb[y * 1080 + x] = color;
+}
+
+/* DIAG: one 70x70 block per *started* board_init_r initcall.
+ * 10 blocks per row from y=700; the COLOR encodes the decade:
+ *   0-9 white, 10-19 cyan, 20-29 green, 30-39 orange, 40-49 purple,
+ *   50-59 pink, 60+ gray. The last block's color + column = the index.
+ * Armed only once board_init_r is entered.
+ */
+static int diag_ic_n;
+static int diag_r_ready;
+
+void diag_initcall_tick(void)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x9c000000;
+	static const unsigned int dc[7] = {
+		0xffffffff, 0xff00ffff, 0xff00ff00, 0xffff8020,
+		0xff8000ff, 0xff4080ff, 0xff404040
+	};
+	int n, x0, y0, x, y, i;
+
+	if (!diag_r_ready)
+		return;
+	n = diag_ic_n++;
+	if (n < 70) {
+		x0 = 10 + (n % 10) * 100;
+		y0 = 700 + (n / 10) * 100;
+		for (y = y0; y < y0 + 70; y++)
+			for (x = x0; x < x0 + 70; x++)
+				fb[y * 1080 + x] = dc[n / 10 < 7 ? n / 10 : 6];
+	}
+	/* DIAG: tick counter as an 8-bit binary readout at the very bottom,
+	 * bit0 leftmost (x=140), bit7 rightmost (x=840), lit = white.
+	 * Redrawn on every tick, so the last value on screen is exact. */
+	for (i = 0; i < 8; i++) {
+		unsigned int c = ((n >> i) & 1) ? 0xffffffff : 0xff101010;
+		int bx = 140 + i * 100;
+		for (y = 2200; y < 2290; y++)
+			for (x = bx; x < bx + 70; x++)
+				fb[y * 1080 + x] = c;
+	}
+}
+
+void diag_probe_arm(void);
+
+void diag_initcall_arm(void)
+{
+	diag_ic_n = 0;
+	diag_r_ready = 1;
+	/* arm the per-device probe counter injected into drivers/core/device.c */
+	diag_probe_arm();
+}
+
 void board_init_r(gd_t *new_gd, ulong dest_addr)
