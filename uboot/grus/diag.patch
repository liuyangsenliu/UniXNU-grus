+/* DIAG: paint a rectangle into the continuous-splash framebuffer (grus).
+ * 0x9c000000 is cont_splash_region per the stock device tree (36MB, 1080 wide).
+ */
+static void diag_band(int y0, int y1, unsigned int color)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x9c000000;
+	int x, y;
+
+	for (y = y0; y < y1; y++)
+		for (x = 0; x < 270; x++)
+			fb[y * 1080 + x] = color;
+}
+
+/* DIAG: one white 70x70 block per *started* board_init_r initcall.
+ * 10 blocks per row from y=600. Only armed once board_init_r is entered, so
+ * the same macro used by board_init_f does not touch the framebuffer there.
+ */
+static int diag_ic_n;
+static int diag_r_ready;
+
+void diag_initcall_tick(void)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x9c000000;
+	int n, x0, y0, x, y;
+
+	if (!diag_r_ready)
+		return;
+	n = diag_ic_n++;
+	if (n >= 65)
+		return;
+	x0 = 10 + (n % 10) * 100;
+	y0 = 600 + (n / 10) * 100;
+	for (y = y0; y < y0 + 70; y++)
+		for (x = x0; x < x0 + 70; x++)
+			fb[y * 1080 + x] = 0xffffffff;
+}
+
+void diag_initcall_arm(void)
+{
+	diag_ic_n = 0;
+	diag_r_ready = 1;
+}
+
 void board_init_r(gd_t *new_gd, ulong dest_addr)
 {
+	/* DIAG: board_init_r reached */
+	diag_band(300, 450, 0xffffff00);
+	diag_initcall_arm();
