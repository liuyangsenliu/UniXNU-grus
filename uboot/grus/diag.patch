+/* DIAG: proof-of-life paint into the continuous-splash framebuffer (grus) */
+static void diag_band(int y0, int y1, unsigned int color)
+{
+	volatile unsigned int *fb = (volatile unsigned int *)0x9c000000;
+	int x, y;
+
+	for (y = y0; y < y1; y++)
+		for (x = 0; x < 270; x++)
+			fb[y * 1080 + x] = color;
+}
+
