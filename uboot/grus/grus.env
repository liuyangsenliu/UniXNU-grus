stdin=serial
stdout=serial
stderr=serial
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# v27 boot chain (no console, screen bands are the status line):
#   rows 0-99   white : bootcmd started
#   rows 100-124 cyan : scsi scan returned (UFS up or errored)
#   then bootflow scan -lb boots \EFI\BOOT\BOOTAA64.EFI from the FAT
#   payload volume; if nothing boots, fall back to fastboot so the
#   host can reflash for the next iteration.
bootcmd=mw.l 0x9c000000 0xffffffff 0x6978; scsi scan; mw.l 0x9c069780 0xff00ffff 0x6978; bootflow scan -lb; fastboot usb 0
