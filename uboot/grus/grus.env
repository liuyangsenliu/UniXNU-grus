stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=scsi scan; mmc rescan; usb start
fastboot=fastboot usb 0
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000

# grus stores everything on UFS, which U-Boot exposes as SCSI targets; the
# partition numbering is unknown until first boot, so do not hardcode it.
# The payload FAT volume (flashed to the vendor partition) carries
# \EFI\BOOT\BOOTAA64.EFI, which `bootflow scan` discovers on any block
# device and boots via the EFI bootmeth -- that is UniXNU.efi.
#
# If no bootflow is found (no payload flashed, or UFS not up yet), fall
# back to U-Boot's own fastboot gadget so the host can inspect/flash.
unixnu_boot=bootflow scan -lb
unixnu_fallback=fastboot usb 0

bootmenu_0=Boot UniXNU (scan EFI payload)=run unixnu_boot
bootmenu_1=Enable fastboot mode=run fastboot
bootmenu_2=Reset device=reset
menucmd=bootmenu
bootdelay=5
bootcmd=run unixnu_boot; run unixnu_fallback
