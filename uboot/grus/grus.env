stdin=serial
stdout=serial
stderr=serial
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# v28 boot chain. There is no console, so the screen bands are the status line:
#   rows   0..149  white  : main_loop entered (inject-forceboot)
#   rows 150..199  green  : the C-level paint completed
#   rows 100..124  cyan   : scsi scan returned (UFS probed lazily)
#   rows 125..149  yellow : \EFI\BOOT\BOOTAA64.EFI was loaded from p80
# bootflow scan is deliberately NOT used: it walks only the first 30
# partitions of a disk and the payload volume is p80 (vendor). Load the
# loader by partition number instead -- 0:50 is hexadecimal, 0x50 = 80.
bootcmd=mw.l 0x9c000000 0xffffffff 0x6978; scsi scan; mw.l 0x9c069780 0xff00ffff 0x6978; if load scsi 0:50 ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then mw.l 0x9c083d60 0xffffff00 0x6978; bootefi ${kernel_addr_r}; fi; fastboot usb 0
