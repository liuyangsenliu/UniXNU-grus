stdin=serial
stdout=serial
stderr=serial
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# DIAG: if the phone power-cycles ~20s after the boot logo, U-Boot reached the
# environment (proves U-Boot is alive). If it freezes forever, U-Boot dies in
# board_init_f / early init.
bootcmd=echo UBOOT-ALIVE; sleep 20; reset
