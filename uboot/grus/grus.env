stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# Decisive bootcmd probe: paint the first 100 rows of the splash framebuffer
# white. Does not depend on any console; if these rows turn white, main_loop
# reached and executed bootcmd, full stop.
bootcmd=mw.l 0x9c000000 0xffffffff 0x1a5e0; sleep 60
