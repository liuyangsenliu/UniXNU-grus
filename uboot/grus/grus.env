stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# CONSOLE bring-up probe: if the framebuffer console works, this text lands on
# the panel. No reset on purpose so the output stays visible for a photo.
bootcmd=echo UBOOT-CONSOLE-OK; version; bdinfo; sleep 60
