stdin=serial
stdout=serial
stderr=serial
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# DIAG build markers (top -> bottom): blue _main, red board_init_f,
# yellow board_init_r, magenta board_init_f returned (relocating),
# white blocks = board_init_r initcall counter, white band = env reached.
bootcmd=echo UBOOT-ALIVE; mw.l 0x9c20f580 0xffffffff 0x1a5e0; sleep 15; reset
