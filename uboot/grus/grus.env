stdin=serial
stdout=serial
stderr=serial
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# v29 boot chain. There is no console, so the screen is the status line
# (framebuffer 0x9c000000, 1080 px per row, row stride 0x10e0 bytes):
#   rows   0..149  white   : main_loop entered      (inject-forceboot)
#   rows 150..199  green   : C-level paint finished  (inject-forceboot)
#   rows 100..124  cyan    : `scsi scan` succeeded   (UFS probed lazily)
#   rows 125..149  yellow  : \EFI\BOOT\BOOTAA64.EFI loaded from p80
#   rows 200..224  magenta : fell through to fastboot
# bootflow scan is deliberately NOT used: it walks only the first 30
# partitions of a disk and the payload volume is p80 (vendor). Load the
# loader by partition number instead -- 0:50 is hexadecimal, 0x50 = 80.
bootcmd=if scsi scan; then mw.l 0x9c069780 0xff00ffff 0x6978; if load scsi 0:50 ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then mw.l 0x9c083d60 0xffffff00 0x6978; bootefi ${kernel_addr_r}; fi; fi; mw.l 0x9c0d2f00 0xffff00ff 0x6978; fastboot usb 0
