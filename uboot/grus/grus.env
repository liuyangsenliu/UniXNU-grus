stdin=serial
stdout=serial
stderr=serial
preboot=
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
bootdelay=0
# DIAG build: bands painted by diag.patch are blue (_main), red (board_init_f)
# and yellow (board_init_r). A white band here proves the environment ran.
bootcmd=echo UBOOT-ALIVE; mw.l 0x9c1da6c0 0xffffffff 0x20000; sleep 15; reset
